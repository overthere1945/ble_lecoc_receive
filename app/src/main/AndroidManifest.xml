<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- change(add)-hyungchul-20260513-1600: BLE 기능 필요 선언 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- change(add)-hyungchul-20260513-1600: Android 11 이하 Bluetooth 기본 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>

    <!-- change(add)-hyungchul-20260513-1600: Android 11 이하 Bluetooth admin 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>

    <!-- change(add)-hyungchul-20260513-1600: Android 11 이하 BLE scan에 필요한 location 권한 -->
    <!-- 정밀한 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 대략적인 위치 권한 (반드시 함께 있어야 함) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- change(add)-hyungchul-20260513-1600: Android 12 이상 BLE scan 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- change(add)-hyungchul-20260513-1600: Android 12 이상 GATT/L2CAP connect 권한 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- change(add)-hyungchul-20260513-1600: main activity 선언 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>